// SPDX-License-Identifier: LGPL-3.0-or-later
#include "Common.ogsfh"  // defines VS_ScreenQuad, VSUV, pixelOut/colorOut, etc.
uniform texture2D sceneTexture;
uniform sampler2D sceneSampler = sampler_state { Texture = <sceneTexture>; };
uniform texture2D stmapTexture;
uniform sampler2D stmapSampler = sampler_state { Texture = <stmapTexture>; };
// Maya currently uses identity transforms; the EXR-window test supplies offsets.
uniform vec4 outputTransform = {1.0, 1.0, 0.0, 0.0};
uniform vec4 stmapTransform = {1.0, 1.0, 0.0, 0.0};
uniform vec4 sourceTransform = {1.0, 1.0, 0.0, 0.0};
GLSLShader LensPixel
{
    // Distortion logic lives in its own .glsl file for easier testing.
    #include "stmap_lookup.glsl"
    void main()
    {
        // Common.ogsfh forwards the quad's UV as VSUV without changing it.
        // Maya's quad/EXR orientation is explained in stmap_lookup.glsl.
        colorOut = sampleSceneThroughStmap(sceneSampler, stmapSampler, VSUV,
                                           outputTransform, stmapTransform, sourceTransform);
    }
}
technique Main
{
    pass p0
    {
        VertexShader (in VS_INPUT_ScreenQuad, out VS_TO_PS_ScreenQuad) = VS_ScreenQuad;
        PixelShader (in VS_TO_PS_ScreenQuad, out pixelOut) = LensPixel;
    }
}
